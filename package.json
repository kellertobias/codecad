{
  "name": "@tobisk/codecad",
  "version": "0.7.0",
  "description": "Code-driven 3D CAD and fabrication library for TypeScript.",
  "license": "Apache-2.0",
  "author": "Tobias Keller",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kellertobias/codecad.git"
  },
  "bugs": {
    "url": "https://github.com/kellertobias/codecad/issues"
  },
  "homepage": "https://github.com/kellertobias/codecad#readme",
  "keywords": [
    "cad",
    "cnc",
    "fabrication",
    "sheet-metal",
    "typescript"
  ],
  "sideEffects": false,
  "overrides": {
    "dompurify": "3.4.15"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "bin": {
    "codecad": "bin/codecad.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "check:compat": "tsc6 --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "format": "prettier --write src examples web tests package.json tsconfig.json README.md",
    "format:check": "prettier --check src examples web tests package.json tsconfig.json README.md",
    "dev": "node --import tsx src/server.ts",
    "build": "node --import tsx src/native-rebuild.ts examples/kitchen-cabinet/index.ts output/kitchen-cabinet",
    "cad:build": "node --import tsx src/native-rebuild.ts",
    "package:build": "tsc --project tsconfig.package.json",
    "package:check": "npm run package:build && node --input-type=module --eval \"import('@tobisk/codecad').then(({ Project, Shapes }) => { if (!Project || !Shapes) throw new Error('Missing public CAD API') })\"",
    "prepack": "npm run package:check",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "examples": "npm run build",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "26.5.1",
    "@types/pdfkit": "0.17.6",
    "@types/svg-to-pdfkit": "0.1.4",
    "@types/three": "0.186.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "prettier": "3.9.6",
    "semantic-release": "25.0.9",
    "tsx": "4.23.13",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "dependencies": {
    "brepjs": "19.0.4",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "monaco-editor": "^0.56.0",
    "occt-wasm": "5.0.0",
    "pdfjs-dist": "6.3.289",
    "pdfkit": "0.20.2",
    "svg-to-pdfkit": "0.1.8",
    "three": "0.186.0"
  }
}
