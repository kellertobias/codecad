{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodeCAD",
  "version": "0.3.0",
  "identifier": "de.tobisk.codecad",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "../desktop"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CodeCAD",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#11171c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": [
      "app"
    ],
    "resources": {
      "../.codecad/desktop-runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
